{
  "name": "startup-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "B2B sourcing and manufacturing platform backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
